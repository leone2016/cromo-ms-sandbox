{
  "extends": "./node_modules/utransfer-tsconfig/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "incremental": true,
    "removeComments": true,
    "sourceMap": true,
    "ignoreDeprecations": "5.0",
    "paths": {
      "handler/*": ["src/handler/*"],
      "constant/*": ["src/constant/*"],
      "error/*": ["src/error/*"],
      "gateway/*": ["src/gateway/*"],
      "infrastructure/*": ["src/infrastructure/*"],
      "@nutriplan/infrastructure/*": ["src/infrastructure/*"],
      "@nutriplan/schema": ["src/schema/index.ts"],
      "@nutriplan/schema/*": ["src/schema/*"],
      "@nutriplan/modules/*": ["src/modules/*"],
      "middleware/*": ["src/middleware/*"],
      "repository/*": ["src/repository/*"],
      "service/*": ["src/service/*"],
      "types/*": ["types/*"],
      "@nutriplan/types/*": ["types/*"],
      "soap/*": ["src/soap/*"]
    }
  },
  "include": ["src/**/*.ts", "serverless.ts"],
  "exclude": [
    "node_modules/**/*",
    ".serverless/**/*",
    ".webpack/**/*",
    ".vscode/**/*",
    ".idea/**/*"
  ]
}
