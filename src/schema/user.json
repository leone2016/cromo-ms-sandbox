{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "http://utr/User",
  "title": "User",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "number"
    },
    "email": {
      "type": "string"
    },
    "passwordHash": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": ["Patient", "Coach"]
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    }
  },
  "required": ["id", "email", "passwordHash", "name", "role"]
}
